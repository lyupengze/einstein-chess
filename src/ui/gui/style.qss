/* 纯 CSS 语法！ */
QMainWindow, QWidget {
    background-color: #2c3e50;
}

QLabel#statusLabel {
    color: #ecf0f1;
    font-family: "Microsoft YaHei";
    font-size: 18px;
    font-weight: bold;
}

QPushButton {
    background-color: #3498db;
    color: white;
    border-radius: 5px;
    padding: 8px 16px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #2980b9;
}
QDialog {
    background-color: #2c3e50;
}
QDialog QLabel {
    color: #ecf0f1;
    font-size: 14px;
}
QRadioButton {
    color: #ecf0f1;
    font-size: 14px;
}
QRadioButton::indicator {
    width: 16px;
    height: 16px;
}