QMainWindow, QWidget {
    background-color: #2c3e50;
}

QLabel#statusLabel {
    color: #ecf0f1;
    font-family: "Microsoft YaHei";
    font-size: 18px;
    font-weight: bold;
}

QPushButton {
    background-color: #3498db;
    color: white;
    border-radius: 5px;
    padding: 8px 16px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #2980b9;
}

QDialog {
    background-color: #2c3e50;
}

QDialog QLabel {
    color: #ecf0f1;
    font-size: 14px;
}

QRadioButton {
    color: #ecf0f1;
    font-size: 14px;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
}

QLineEdit {
    background-color: #1a252f;
    color: #ecf0f1;
    border: 1px solid #3498db;
    border-radius: 5px;
    padding: 6px 10px;
    font-size: 14px;
}

QListWidget {
    background-color: #1a252f;
    color: #ecf0f1;
    border: 1px solid #34495e;
    border-radius: 5px;
    outline: none;
}

QListWidget::item {
    padding: 8px;
}

QListWidget::item:selected {
    background-color: #3498db;
    color: white;
}

QDialog {
    background-color: #2c3e50;
}

QLabel#toast {
    background-color: rgba(0, 0, 0, 0.85);
    color: white;
    padding: 10px 20px;
    border-radius: 8px;
    font-size: 15px;
    font-family: "Microsoft YaHei";
}

QListWidget#historyList {
    background-color: #1a252f;
    color: #ecf0f1;
    border-radius: 5px;
    padding: 5px;
    font-size: 13px;
    border: 1px solid #34495e;
}

QListWidget#historyList::item {
    padding: 4px 0px;
    border-bottom: 1px solid #2c3e50;
}

QListWidget#historyList::item:selected {
    background-color: #3498db;
    color: white;
}